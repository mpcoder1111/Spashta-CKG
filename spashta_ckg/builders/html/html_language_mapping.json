{
  "_meta": {
    "description": "Maps HTML Tags and Attributes to CKG Nodes and Edges.",
    "parser": "html.parser",
    "version": "2.1-strict",
    "note": "Only statically provable structural relations are emitted. Behavioral effects are deferred to ambiguities."
  },
  "file_node_type": "Template",
  "attribute_interactions": [
    {
      "attribute": "hx-get",
      "emits_edge": "calls_api",
      "target_node_type": "Route"
    },
    {
      "attribute": "hx-post",
      "emits_edge": "calls_api",
      "target_node_type": "Route"
    },
    {
      "attribute": "hx-put",
      "emits_edge": "calls_api",
      "target_node_type": "Route"
    },
    {
      "attribute": "hx-delete",
      "emits_edge": "calls_api",
      "target_node_type": "Route"
    },
    {
      "attribute": "hx-patch",
      "emits_edge": "calls_api",
      "target_node_type": "Route"
    },
    {
      "attribute": "hx-target",
      "emits_edge": "targets_element",
      "target_node_type": "StyleID"
    },
    {
      "attribute": "hx-trigger",
      "emits_edge": "triggers_event",
      "target_node_type": "Event",
      "listener_edge": "listens_to"
    },
    {
      "attribute": "hx-swap-oob",
      "value_from_context": "id",
      "emits_edge": "oob_swaps",
      "target_node_type": "StyleID"
    }
  ],
  "tag_interactions": {
    "img": [
      {
        "attribute": "src",
        "emits_edge": "links_static_asset",
        "target_node_type": "StaticAsset"
      }
    ],
    "iframe": [
      {
        "attribute": "src",
        "emits_edge": "links_static_asset",
        "target_node_type": "StaticAsset"
      }
    ],
    "video": [
      {
        "attribute": "src",
        "emits_edge": "links_static_asset",
        "target_node_type": "StaticAsset"
      }
    ],
    "audio": [
      {
        "attribute": "src",
        "emits_edge": "links_static_asset",
        "target_node_type": "StaticAsset"
      }
    ],
    "source": [
      {
        "attribute": "src",
        "emits_edge": "links_static_asset",
        "target_node_type": "StaticAsset"
      }
    ],
    "link": [
      {
        "attribute": "href",
        "condition": {
          "rel": [
            "stylesheet",
            "icon",
            "shortcut icon"
          ]
        },
        "emits_edge": "links_static_asset",
        "target_node_type": "StaticAsset"
      }
    ],
    "script": [
      {
        "attribute": "src",
        "emits_edge": "links_static_asset",
        "target_node_type": "StaticAsset"
      }
    ],
    "meta": [
      {
        "attribute": "content",
        "condition": {
          "property": "og:image"
        },
        "emits_edge": "links_static_asset",
        "target_node_type": "StaticAsset"
      }
    ],
    "a": [
      {
        "attribute": "href",
        "emits_edge": "calls_api",
        "target_node_type": "Route"
      }
    ],
    "form": [
      {
        "attribute": "action",
        "emits_edge": "submits_form",
        "target_node_type": "Route"
      }
    ]
  },
  "template_relations": {
    "_doc": "Django/Jinja template-tag relations: {% TAG \"path\" %} -> edge (Template->Template), matched to the target Template by its logical /templates/-relative name.",
    "extends": "extends_template",
    "include": "includes_template"
  },
  "class_usage": {
    "_doc": "A markup class attribute applies CSS classes: class=\"a b c\" -> one uses_style edge (Template->StyleClass) per LITERAL whitespace-separated token, joined by name to the CSS StyleClass (defines) + JS queries_dom. A token containing a template expression ({{ }}/{% %}) is a dynamic ambiguity, never a guessed edge. Empty {} = off.",
    "attribute": "class",
    "emits_edge": "uses_style",
    "target_node_type": "StyleClass"
  },
  "script_class_usage": {
    "_doc": "dead-code-accuracy P3: an inline <script> block in a template applies CSS classes at runtime — el.classList.add/remove/toggle('x') and querySelector('.x')/querySelectorAll('.x') (a SIMPLE .class selector only). Emits uses_style (Template->StyleClass) for the LITERAL class name, closing the 'JS in a template, not a .js file' blind spot (the JS builder scans .js files only). A variable selector stays unmodeled. Empty {} = off.",
    "classlist_methods": ["add", "remove", "toggle"],
    "query_methods": ["querySelector", "querySelectorAll"],
    "emits_edge": "uses_style",
    "target_node_type": "StyleClass"
  }
}