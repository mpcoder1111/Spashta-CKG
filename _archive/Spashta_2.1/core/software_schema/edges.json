{
  "_meta": {
    "logic": "Separates syntax-level facts from framework-level assumptions.",
    "version": "1.4",
    "changelog_1.4": "Added has_field, references, listens_to edges. Expanded defines.to to include Variable, Field, Constant. Expanded imports.from to include Function, Method (enables function-scoped/lazy import tracking — universal in Python, JS, PHP). All additions are universal."
  },
  "direct_structural": {
    "imports": {
      "from": [
        "File",
        "Module",
        "Stylesheet",
        "Function",
        "Method"
      ],
      "to": [
        "Module",
        "Package",
        "Stylesheet",
        "Class",
        "Function",
        "Variable",
        "File"
      ]
    },
    "defines": {
      "from": [
        "File",
        "Stylesheet"
      ],
      "to": [
        "Class",
        "Function",
        "Interface",
        "Enum",
        "Route",
        "Trait",
        "Component",
        "Hook",
        "Variable",
        "Constant",
        "Field",
        "TestCase",
        "StyleClass",
        "StyleID",
        "StyleElement"
      ]
    },
    "contains_member": {
      "from": [
        "Class",
        "Trait"
      ],
      "to": [
        "Method",
        "Variable",
        "Field",
        "Constant"
      ],
      "meaning": "Defines internal object structure"
    },
    "has_field": {
      "from": [
        "Class"
      ],
      "to": [
        "Field"
      ],
      "meaning": "Data model declares a typed, persistent field (ORM column, schema attribute)"
    },
    "extends": {
      "from": [
        "Class"
      ],
      "to": [
        "Class"
      ]
    },
    "implements_interface": {
      "from": [
        "Class"
      ],
      "to": [
        "Interface"
      ]
    },
    "uses_trait": {
      "from": [
        "Class"
      ],
      "to": [
        "Trait"
      ]
    },
    "calls": {
      "from": [
        "Function",
        "Method",
        "Hook",
        "File"
      ],
      "to": [
        "Function",
        "Method"
      ]
    },
    "registers_event_handler": {
      "from": [
        "Function",
        "Method",
        "Hook",
        "File"
      ],
      "to": [
        "Event"
      ]
    },
    "throws_exception": {
      "from": [
        "Function",
        "Method"
      ],
      "to": [
        "Class"
      ],
      "meaning": "Declares or raises an exception type"
    },
    "reads_from": {
      "from": [
        "Function",
        "Method"
      ],
      "to": [
        "Variable",
        "DataModel",
        "File"
      ],
      "meaning": "Reads state or data"
    },
    "writes_to": {
      "from": [
        "Function",
        "Method"
      ],
      "to": [
        "Variable",
        "DataModel"
      ],
      "meaning": "Mutates state or data"
    }
  },
  "reference_symbolic": {
    "decorates": {
      "from": [
        "Function",
        "Class"
      ],
      "to": [
        "Function",
        "Class"
      ]
    },
    "renders_template": {
      "from": [
        "Route",
        "Function"
      ],
      "to": [
        "Template",
        "Fragment"
      ]
    },
    "calls_api": {
      "from": [
        "Function",
        "Template",
        "Component"
      ],
      "to": [
        "Route"
      ]
    },
    "submits_form": {
      "from": [
        "Template"
      ],
      "to": [
        "Route"
      ]
    },
    "links_static_asset": {
      "from": [
        "Template"
      ],
      "to": [
        "StaticAsset"
      ]
    },
    "targets_element": {
      "from": [
        "StaticAsset",
        "Template"
      ],
      "to": [
        "Template",
        "StyleID",
        "StyleClass"
      ],
      "meaning": "CSS selector targets HTML elements"
    },
    "triggers_event": {
      "from": [
        "Template",
        "Fragment"
      ],
      "to": [
        "Event"
      ]
    },
    "expects_contract": {
      "from": [
        "Route",
        "Function"
      ],
      "to": [
        "APIContract"
      ]
    },
    "references": {
      "from": [
        "Class",
        "Field"
      ],
      "to": [
        "Class"
      ],
      "meaning": "Relational reference between data models (ForeignKey, OneToOne, ManyToMany, @ManyToOne, belongsTo)"
    },
    "listens_to": {
      "from": [
        "Function",
        "Method"
      ],
      "to": [
        "Event",
        "Signal"
      ],
      "meaning": "Subscribes to or handles an event or signal (Django @receiver, Node EventEmitter.on, Java @EventListener)"
    }
  }
}